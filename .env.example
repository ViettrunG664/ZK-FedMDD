# Copy to .env and fill in. Never commit .env.

# Ethereum Sepolia (deployment and on-chain measurements)
SEPOLIA_RPC=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_KEY=
TIP_GWEI=0.1
ROUNDS=2

# Registrar master key: 32 random bytes as hex (openssl rand -hex 32).
# Held by the registrar only; see the custody discussion in the paper.
MASTER_SALT=

# One block per facility served by server_fl.js (n = 1, 2, ...)
FACILITY_1_HOSPITAL=BV.HOSPA
FACILITY_1_DOCTOR_ID=
FACILITY_1_SALT=

# Off-chain storage of encrypted weights (optional)
AES_KEY=
LIGHTHOUSE_API_KEY=
LOTUS_API_TOKEN=

# Ports and tool paths
PORT=3000
REGISTER_PORT=3001
FL_PORT=3002
NPX_PATH=
NODE_PATH=
